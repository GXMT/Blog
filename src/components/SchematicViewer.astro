---
interface Props {
  /** public/schematics 안의 .schem/.litematic/.nbt 경로 */
  schematic: string;
  height?: number;
  /**
   * 텍스처용 리소스팩 URL (동일 출처 권장, CORS 회피).
   * 로컬은 /mc-client.jar, 배포 시엔 호스팅된 팩 URL로 교체하세요.
   */
  resourcePack?: string;
}
const { schematic, height = 500, resourcePack = '/mc-client.jar' } = Astro.props;
---

<div
  class="schem"
  data-schematic={schematic}
  data-rp={resourcePack}
  style={`--h:${height}px`}
>
  <button type="button" class="schem__load">
    <span>🧊 Load interactive 3D viewer</span>
    <small>Drag to rotate · scroll to zoom</small>
  </button>
  <canvas class="schem__canvas" hidden></canvas>
  <p class="schem__status" role="status" hidden></p>
</div>

<script>
  // heavy Babylon engine은 클릭 시 동적 import → 초기 로딩 방해 없음
  function u8ToBase64(bytes: Uint8Array): string {
    let bin = '';
    const chunk = 0x8000;
    for (let i = 0; i < bytes.length; i += chunk) {
      bin += String.fromCharCode.apply(
        null,
        bytes.subarray(i, i + chunk) as unknown as number[],
      );
    }
    return btoa(bin);
  }

  function initViewer(root: HTMLElement) {
    const btn = root.querySelector<HTMLButtonElement>('.schem__load');
    const canvas = root.querySelector<HTMLCanvasElement>('.schem__canvas');
    const status = root.querySelector<HTMLElement>('.schem__status');
    const schematicUrl = root.getAttribute('data-schematic');
    const rp = root.getAttribute('data-rp');
    if (!btn || !canvas || !status || !schematicUrl) return;

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      status.hidden = false;
      status.textContent = 'Loading 3D engine…';
      try {
        const [{ renderSchematic }, bufferMod, res] = await Promise.all([
          import('@enginehub/schematicwebviewer'),
          import('buffer'),
          fetch(schematicUrl),
        ]);
        // 라이브러리가 Node의 전역 Buffer를 기대함 → 브라우저에 폴리필 주입
        const g = globalThis as unknown as { Buffer?: unknown };
        if (!g.Buffer) g.Buffer = bufferMod.Buffer;
        if (!res.ok) throw new Error('schematic fetch failed (' + res.status + ')');
        const bytes = new Uint8Array(await res.arrayBuffer());
        const base64 = u8ToBase64(bytes);

        const cssH =
          parseInt(getComputedStyle(root).getPropertyValue('--h')) || 500;
        const width = Math.min(root.getBoundingClientRect().width || 800, 960);

        canvas.hidden = false;
        status.textContent = 'Rendering…';
        await renderSchematic(canvas, base64, {
          size: { width, height: cssH },
          // 블록 모델/텍스처 소스: 동일 출처 client.jar (CORS 불필요)
          getClientJarUrl: rp ? async () => rp : undefined,
          orbit: true,
          orbitSpeed: 0.01,
          renderArrow: false,
          renderBars: false,
          antialias: true,
          backgroundColor: 'transparent',
        });
        btn.hidden = true;
        status.hidden = true;
      } catch (err) {
        status.hidden = false;
        status.textContent =
          'Could not load viewer: ' +
          (err instanceof Error ? err.message : String(err));
        btn.disabled = false;
        console.error('[SchematicViewer]', err);
      }
    });
  }

  document
    .querySelectorAll<HTMLElement>('.schem')
    .forEach((el) => initViewer(el));
</script>

<style>
  .schem {
    width: 100%;
    margin: 2rem 0;
  }
  .schem__load {
    width: 100%;
    min-height: var(--h, 500px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 2px dashed var(--border, #ccc);
    border-radius: 12px;
    background: var(--surface, #f4f4f5);
    color: var(--fg);
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
  }
  .schem__load small {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .schem__load:hover {
    border-color: var(--accent);
  }
  .schem__load:disabled {
    cursor: progress;
    opacity: 0.7;
  }
  .schem__canvas {
    width: 100%;
    height: var(--h, 500px);
    border-radius: 12px;
    display: block;
    touch-action: none;
    background: var(--surface, #f4f4f5);
  }
  .schem__status {
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
    margin: 0.5rem 0 0;
  }
</style>
