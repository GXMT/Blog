---
import Wordmark from './Wordmark.astro';

const path = Astro.url.pathname;
---

<header class="site-header">
  <a href="/" class="mark" aria-label="참결 홈"><Wordmark /></a>
  <nav class="cap" aria-label="주요 메뉴">
    <a href="/shop" aria-current={path.startsWith('/shop') ? 'page' : undefined}>구매</a>
    <a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}>소개</a>
  </nav>
</header>

<style>
  .site-header {
    padding: var(--gutter) var(--gutter) 0;
  }
  nav {
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
