---
import { SITE_TITLE } from '../consts.mjs';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const links = [
  { href: '/', label: '홈', code: '00' },
  { href: '/blog', label: '기록', code: '01' },
  { href: '/about', label: '소개', code: '02' },
];
---

<header class="site-header">
  <a href="/" class="brand" aria-label={`${SITE_TITLE} 홈`}>
    <span class="brand-mark" aria-hidden="true">✶</span>
    <span class="brand-name">{SITE_TITLE}</span>
  </a>
  <nav aria-label="주요 메뉴">
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={[{ active: isActive(l.href) }]}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          <span class="code mono">{l.code}</span>
          {l.label}
        </a>
      ))
    }
    <a href="/rss.xml" class="rss mono">RSS</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    background: var(--paper);
    border-bottom: var(--line-thick) solid var(--ink);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem var(--gutter);
    background: var(--chlorophyll);
    border-right: var(--line-thick) solid var(--ink);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    letter-spacing: -0.02em;
  }
  .brand-mark {
    display: inline-block;
    transition: transform 0.4s cubic-bezier(0.7, 0, 0.3, 1);
  }
  .brand:hover .brand-mark {
    transform: rotate(180deg);
  }
  nav {
    display: flex;
    align-items: stretch;
  }
  nav a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 clamp(0.7rem, 2vw, 1.6rem);
    border-left: var(--line) solid var(--ink);
    color: var(--ink);
    text-decoration: none;
    font-weight: 800;
    font-size: 0.95rem;
  }
  nav a:hover {
    background: var(--ink);
    color: var(--chlorophyll);
  }
  nav a.active {
    background: var(--ink);
    color: var(--paper);
  }
  .code {
    font-size: 0.7rem;
    font-weight: 400;
    opacity: 0.6;
  }
  .rss {
    font-size: 0.75rem;
    background: var(--signal);
  }
  @media (max-width: 560px) {
    .code,
    nav a.rss {
      display: none;
    }
    .brand-mark {
      display: none;
    }
  }
</style>
