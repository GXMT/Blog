---
import { SITE_TITLE } from '../consts.mjs';

interface Props {
  /** ✕ 버튼이 돌아갈 곳 */
  close?: string;
}
const { close = '/' } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/blog', label: '기록' },
  { href: '/about', label: '소개' },
];
---

<header class="site-header">
  <nav aria-label="주요 메뉴">
    <a href="/">{SITE_TITLE}</a>
    {
      links.map((l, i) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
          {l.label}
          <sup>{String.fromCharCode(0x2460 + i)}</sup>
        </a>
      ))
    }
  </nav>
  <a class="close" href={close} aria-label="닫기">
    <svg viewBox="0 0 40 40" aria-hidden="true">
      <path d="M4 4L36 36M36 4L4 36" stroke="currentColor" stroke-width="2.5" />
    </svg>
  </a>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: var(--gutter);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6em;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  nav a[aria-current='page'] {
    color: var(--accent);
  }
  sup {
    font-size: 0.45em;
    margin-left: 0.05em;
  }
  .close {
    flex: none;
    width: clamp(32px, 4vw, 44px);
    height: clamp(32px, 4vw, 44px);
  }
  .close svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
