---
import BaseHead from '../components/BaseHead.astro';
import Wordmark from '../components/Wordmark.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts.mjs';
import '../styles/global.css';

type Media = { src: string; alt: string; video?: string };
const img = (name: string, alt: string): Media => ({ src: name, alt });
const vid = (name: string, poster: string, alt: string): Media => ({ src: poster, alt, video: name });

// 장마다 사진 묶음(첫 장은 좌측 고정 열)
const chapters: Media[][] = [
  [
    vid('mist', 'mist', '가습 안개가 흐르는 빈 재배실'),
    img('shelf', '선반 위 배지에서 자라는 버섯'),
    img('rows', '줄지어 올라온 갓들'),
  ],
  [
    img('block', '흰 균사가 덮인 원통형 배지'),
    img('stack', '쌓아 둔 배지 더미'),
    img('canopy', '배지 위로 올라온 버섯'),
  ],
  [
    img('pair', '장갑 낀 손 위의 참송이 두 개'),
    img('harvest', '수확 상자에 가득 담긴 참송이'),
    img('hand', '손에 든 참송이 한 개'),
    img('sunlit', '햇빛 아래 손에 든 참송이'),
  ],
  [
    vid('box', 'box-video', '햇빛 아래 상자에 담긴 참송이'),
    img('box', '이끼 위에 가지런히 놓인 참송이'),
    img('box2', '이끼를 깐 상자에 담긴 참송이'),
  ],
];

const srcset = (n: string) => `/media/${n}-sm.webp 800w, /media/${n}.webp 1600w`;
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={`${SITE_TITLE} 농장`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <!-- 고정 워드마크: 콘텐츠가 그 위로 지나감 -->
    <div class="fixed-mark" aria-hidden="true"><Wordmark /></div>

    <nav class="corner cap" aria-label="주요 메뉴">
      <a href="/about">소개</a>
    </nav>

    <main>
      <h1 class="sr-only">참결 농장</h1>

      <section class="hero">
        <figure class="hero-frame">
          <img
            src="/media/room.webp"
            srcset={srcset('room')}
            sizes="(max-width: 760px) 100vw, 82vw"
            alt="양쪽으로 배지 선반이 길게 이어진 재배실 통로"
            fetchpriority="high"
          />
        </figure>
      </section>

      {
        chapters.map((media, ci) => (
          <section class:list={['chapter', { flip: ci % 2 === 1 }]}>
            <div class="side">
              <div class="side-inner">
                <figure class="lead-media" data-reveal>
                  {media[0].video ? (
                    <video
                      src={`/media/${media[0].video}.mp4`}
                      poster={`/media/${media[0].src}.webp`}
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      aria-label={media[0].alt}
                    />
                  ) : (
                    <img src={`/media/${media[0].src}-sm.webp`} alt={media[0].alt} loading="lazy" />
                  )}
                </figure>
              </div>
            </div>
            <div class="main">
              <div class="collage">
                {media.slice(1).map((m, i) => (
                  <figure class={`m m${i + 1}`}>
                    <div data-speed={[0.06, -0.08, 0.1][i % 3]}>
                      {m.video ? (
                        <video
                          src={`/media/${m.video}.mp4`}
                          poster={`/media/${m.src}.webp`}
                          autoplay
                          muted
                          loop
                          playsinline
                          preload="metadata"
                          aria-label={m.alt}
                          data-reveal
                        />
                      ) : (
                        <img
                          src={`/media/${m.src}-sm.webp`}
                          srcset={srcset(m.src)}
                          sizes="(max-width: 760px) 90vw, 40vw"
                          alt={m.alt}
                          loading="lazy"
                          data-reveal
                        />
                      )}
                    </div>
                  </figure>
                ))}
              </div>
            </div>
          </section>
        ))
      }
    </main>

    <Footer />
    <Motion />
  </body>
</html>

<style>
  /* ── 고정 워드마크 ───────────────────────── */
  .fixed-mark {
    position: fixed;
    top: var(--gutter);
    left: var(--gutter);
    right: var(--gutter);
    z-index: 0;
    pointer-events: none;
  }
  .corner {
    position: fixed;
    top: calc(var(--gutter) * 0.5);
    right: var(--gutter);
    z-index: 5;
    display: flex;
    gap: 1.25rem;
    mix-blend-mode: difference;
    color: #f4efe7;
  }
  main {
    position: relative;
    z-index: 1;
  }

  /* ── 히어로 ──────────────────────────────── */
  .hero {
    padding-top: calc((100vw - 2 * var(--gutter)) * 0.085 + var(--gutter));
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .hero-frame {
    margin: 0;
    width: min(82vw, 1500px);
    overflow: hidden;
    animation: open 1.4s cubic-bezier(0.7, 0, 0.2, 1) both;
  }
  .hero-frame img {
    width: 100%;
    height: min(41vw, 62vh);
    object-fit: cover;
    animation: settle 2.4s cubic-bezier(0.2, 0.6, 0.2, 1) both;
  }
  @keyframes open {
    from {
      clip-path: inset(45% 0 45% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.18);
    }
  }
  /* ── 장 ──────────────────────────────────── */
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--gutter);
    padding: 12vh var(--gutter) 22vh;
  }
  .side-inner {
    position: sticky;
    top: calc((100vw - 2 * var(--gutter)) * 0.135 + var(--gutter) * 2);
  }
  .lead-media {
    margin: 0;
    max-width: 260px;
  }
  .lead-media img,
  .lead-media video {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .collage {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .m {
    margin: 0;
  }
  .m img,
  .m video {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .m1 {
    grid-column: 1 / span 5;
    margin-top: 8vh;
  }
  .m2 {
    grid-column: 7 / span 6;
  }
  .m3 {
    grid-column: 4 / span 5;
    margin-top: 6vh;
  }
  .flip .m1 {
    grid-column: 8 / span 5;
  }
  .flip .m2 {
    grid-column: 1 / span 6;
    grid-row: 1;
    margin-top: 14vh;
  }
  .flip .m3 {
    grid-column: 5 / span 6;
  }

  /* ── 반응형 ──────────────────────────────── */
  @media (max-width: 760px) {
    .fixed-mark {
      top: 2.6rem;
    }
    .corner {
      top: 0.9rem;
    }
    .hero {
      padding-top: calc((100vw - 2 * var(--gutter)) * 0.13 + 3.5rem);
    }
    .hero-frame {
      width: 100%;
    }
    .hero-frame img {
      height: auto;
      aspect-ratio: 4 / 5;
    }
    .chapter {
      grid-template-columns: 1fr;
      padding-bottom: 14vh;
    }
    .side-inner {
      position: static;
    }
    .lead-media {
      max-width: 55%;
      margin-bottom: 2rem;
    }
    .flip .lead-media {
      margin-left: auto;
    }
    .m1,
    .flip .m1 {
      grid-column: 1 / span 8;
      margin-top: 0;
    }
    .m2,
    .flip .m2 {
      grid-column: 5 / span 8;
      grid-row: auto;
      margin-top: 2rem;
    }
    .m3,
    .flip .m3 {
      grid-column: 2 / span 9;
      margin-top: 2rem;
    }
  }
</style>
