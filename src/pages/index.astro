---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts.mjs';
import '../styles/global.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 큰 단어 목록: 사이트명(소개), 글마다 첫 번째 태그(없으면 제목), 끝에 기록
const words = [
  { label: SITE_TITLE, href: '/about', image: undefined },
  ...posts.map((p) => ({
    label: p.data.tags[0] ?? p.data.title,
    href: `/blog/${p.id}/`,
    image: p.data.heroImage,
  })),
  { label: '기록', href: '/blog', image: undefined },
];
const circled = (i: number) => String.fromCharCode(0x2460 + i);
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <div class="screen">
      <main>
        <h1 class="sr-only">{SITE_TITLE}</h1>
        <nav class="words" aria-label="주요 메뉴">
          {
            words.map((w, i) => (
              <>
                <a class="word" href={w.href}>{w.label}<sup>{circled(i)}</sup></a>
                {w.image && <img class="peek" src={w.image} alt="" loading="lazy" />}{' '}
              </>
            ))
          }
        </nav>
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .screen {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 6vh, 4rem) var(--gutter);
  }
  .words {
    max-width: 14em;
    font-size: clamp(2.6rem, 7.2vw, 7rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-align: center;
  }
  .word {
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }
  sup {
    font-size: 0.32em;
    vertical-align: 1.6em;
    margin-left: 0.04em;
    letter-spacing: 0;
  }
  /* 단어에 올리면 뒤편에 대표 이미지가 떠오름 */
  .peek {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    width: min(32vw, 420px);
    transform: translate(-50%, -50%);
    z-index: 0;
    pointer-events: none;
  }
  @media (hover: hover) {
    .word:hover + .peek {
      display: block;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
