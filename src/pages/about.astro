---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts.mjs';
import '../styles/global.css';
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={`소개 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="container">
      <h1>{SITE_DESCRIPTION}</h1>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    min-height: 60vh;
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    padding-bottom: 6rem;
  }
  h1 {
    margin: 0;
    max-width: 18em;
    font-size: clamp(1.8rem, 4.2vw, 3.8rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
</style>
