---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts.mjs';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`About · ${SITE_TITLE}`}
      description={`About ${SITE_TITLE} — interactive Minecraft farm guides.`}
    />
  </head>
  <body>
    <div class="container">
      <Header />
      <main>
        <div class="prose">
          <h1>About {SITE_TITLE}</h1>
          <p>
            {SITE_TITLE} collects the best Minecraft farm and factory designs and
            presents them as interactive 3D guides you can rotate, zoom, and
            explore layer by layer — with material lists, rates, and build notes.
          </p>
          <p>
            Designs are rebuilt and credited to their original creators. Edit this
            page freely.
          </p>
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
