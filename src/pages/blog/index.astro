---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Motion from '../../components/Motion.astro';
import { SITE_TITLE } from '../../consts.mjs';
import '../../styles/global.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const ymd = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={`기록 · ${SITE_TITLE}`} description="참결 농장의 기록." />
  </head>
  <body>
    <Header />
    <main class="container">
      <h1 class="sr-only">기록</h1>
      <ol class="rows">
        {
          posts.map((post, i) => (
            <li data-reveal>
              <a href={`/blog/${post.id}/`}>
                <span class="no cap">{String(posts.length - i).padStart(2, '0')}</span>
                <span class="title">{post.data.title}</span>
                <span class="desc">{post.data.description}</span>
                <span class="meta cap">
                  <time datetime={post.data.pubDate.toISOString()}>{ymd(post.data.pubDate)}</time>
                  <span>{post.data.tags.join(' · ')}</span>
                </span>
                {post.data.heroImage && <img class="thumb" src={post.data.heroImage} alt="" loading="lazy" />}
              </a>
            </li>
          ))
        }
      </ol>
    </main>
    <Footer />
    <Motion />
  </body>
</html>

<style>
  main {
    padding-bottom: 20vh;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    border-bottom: 1px solid var(--rule);
  }
  .rows a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 4fr) minmax(0, 4fr) minmax(0, 2fr) 110px;
    gap: var(--gutter);
    align-items: start;
    padding: 1.4rem 0 3rem;
  }
  .title {
    font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .desc {
    font-weight: 400;
    line-height: 1.6;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--muted);
  }
  .thumb {
    width: 110px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    justify-self: end;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .rows a:hover .thumb {
    transform: scale(1.06);
  }
  .rows a:hover .title {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media (max-width: 860px) {
    .rows a {
      grid-template-columns: minmax(0, 1fr) 84px;
      gap: 0.5rem 1rem;
      padding-bottom: 2rem;
    }
    .no {
      display: none;
    }
    .title,
    .desc,
    .meta {
      grid-column: 1;
    }
    .thumb {
      grid-column: 2;
      grid-row: 1 / span 3;
      width: 84px;
    }
  }
</style>
