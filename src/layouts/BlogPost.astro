---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSense from '../components/AdSense.astro';
import '../styles/global.css';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags } = Astro.props;
const ymd = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      type="article"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
      tags={tags}
    />
  </head>
  <body>
    <Header />
    <main class="container">
      <article class="post">
        <aside class="side">
          <div class="side-inner">
            <dl class="cap">
              <dt>발행</dt>
              <dd><time datetime={pubDate.toISOString()}>{ymd(pubDate)}</time></dd>
              {
                updatedDate && (
                  <>
                    <dt>수정</dt>
                    <dd><time datetime={updatedDate.toISOString()}>{ymd(updatedDate)}</time></dd>
                  </>
                )
              }
              {
                tags.length > 0 && (
                  <>
                    <dt>분류</dt>
                    <dd>{tags.join(' · ')}</dd>
                  </>
                )
              }
            </dl>
            {heroImage && <img class="hero" src={heroImage} alt={heroAlt ?? ''} />}
            <a class="back cap" href="/blog">← 기록</a>
          </div>
        </aside>
        <div class="body">
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          <div class="prose">
            <slot />
          </div>
          <!-- 본문 하단 광고 (슬롯 ID는 애드센스에서 발급받아 교체) -->
          <AdSense slot="0000000000" minHeight={280} />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 2rem var(--gutter);
    padding: 2.5rem 0 20vh;
  }
  .side-inner {
    position: sticky;
    top: 2rem;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    margin: 0 0 1.5rem;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  .hero {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .back {
    display: inline-block;
    margin-top: 1.5rem;
  }
  h1 {
    margin: 0;
    max-width: 15em;
    font-size: clamp(2rem, 4.6vw, 4.4rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
  .lede {
    max-width: 680px;
    margin: 1.75rem 0 3rem;
    font-size: 1.2rem;
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .post {
      grid-template-columns: 1fr;
    }
    .side {
      order: 2;
      border-top: 1px solid var(--rule);
      padding-top: 1.5rem;
    }
    .side-inner {
      position: static;
    }
    .hero {
      max-width: 160px;
    }
  }
</style>
